# Supabase: publishable key may be used by the client; secret key is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gnani Speech APIs: one key is used for Prisma STT and Timbre TTS.
GNANI_API_KEY=
GNANI_SPEECH_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_LANGUAGE=auto

# Gemma 4 26B A4B through the Google Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
